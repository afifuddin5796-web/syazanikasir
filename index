<!DOCTYPE html>
<html lang="id">
<head>
<!-- PWA Meta Tags -->
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#0f172a">
<link rel="apple-touch-icon" href="https://cdn-icons-png.flaticon.com/512/1170/1170576.png">

<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('sw.js')
      .then(() => console.log('Service Worker Registered'));
  }
</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SembakoKasir - Offline Pro</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- html2canvas -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <!-- HTML5 Barcode & QR Scanner Library -->
    <script src="https://unpkg.com/html5-qrcode"></script>
    <!-- SheetJS (Library Excel Export) -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        @media print {
            body * { visibility: hidden; }
            #struk-area, #struk-area * { visibility: visible; }
            #struk-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 80mm;
                color: black !important;
                background: white !important;
            }
        }
        #reader video, #reader-db video {
            border-radius: 0.5rem;
            object-fit: cover;
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 flex flex-col md:flex-row h-screen overflow-hidden pb-16 md:pb-0">

    <!-- 1. SIDEBAR DESKTOP -->
    <aside class="w-64 bg-slate-800 border-r border-slate-700 flex-col justify-between hidden md:flex">
        <div>
            <div class="p-4 border-b border-slate-700 flex items-center justify-between">
                <h1 class="text-lg font-bold text-emerald-400 flex items-center gap-2">
                    🛒 SembakoKasir
                </h1>
                <span class="text-[10px] bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded border border-emerald-500/30">v1.7</span>
            </div>

            <nav class="p-3 space-y-1">
                <button onclick="switchTab('kasir')" id="nav-kasir" class="nav-btn w-full text-left flex items-center gap-3 px-3 py-2.5 bg-emerald-600 text-white font-medium rounded-lg text-sm shadow-md transition">
                    <span>🖥️</span> Kasir Utama
                </button>
                <button onclick="switchTab('stok')" id="nav-stok" class="nav-btn w-full text-left flex items-center gap-3 px-3 py-2.5 text-slate-300 hover:bg-slate-700/60 rounded-lg text-sm transition">
                    <span>📦</span> Stok Barang
                </button>
                <button onclick="switchTab('keuangan')" id="nav-keuangan" class="nav-btn w-full text-left flex items-center gap-3 px-3 py-2.5 text-slate-300 hover:bg-slate-700/60 rounded-lg text-sm transition">
                    <span>💰</span> Keuangan & Laporan
                </button>
                <button onclick="switchTab('database')" id="nav-database" class="nav-btn w-full text-left flex items-center gap-3 px-3 py-2.5 text-slate-300 hover:bg-slate-700/60 rounded-lg text-sm transition">
                    <span>🗄️</span> Database Produk
                </button>
            </nav>
        </div>

        <div class="p-3 border-t border-slate-700">
            <button onclick="bukaModalPengaturan()" class="w-full flex items-center gap-3 px-3 py-2 text-xs text-slate-400 hover:text-slate-200 transition">
                ⚙️ Pengaturan Toko
            </button>
        </div>
    </aside>

    <!-- 2. NAVIGATION BAR MOBILE -->
    <div class="fixed bottom-0 left-0 right-0 bg-slate-800/95 backdrop-blur border-t border-slate-700 flex justify-around items-center p-2 z-40 md:hidden">
        <button onclick="switchTab('kasir')" id="mob-kasir" class="flex flex-col items-center text-emerald-400 text-[10px] font-medium">
            <span class="text-base">🖥️</span>
            <span>Kasir</span>
        </button>
        <button onclick="switchTab('stok')" id="mob-stok" class="flex flex-col items-center text-slate-400 text-[10px] font-medium">
            <span class="text-base">📦</span>
            <span>Stok</span>
        </button>
        <button onclick="switchTab('keuangan')" id="mob-keuangan" class="flex flex-col items-center text-slate-400 text-[10px] font-medium">
            <span class="text-base">💰</span>
            <span>Laporan</span>
        </button>
        <button onclick="switchTab('database')" id="mob-database" class="flex flex-col items-center text-slate-400 text-[10px] font-medium">
            <span class="text-base">🗄️</span>
            <span>Database</span>
        </button>
        <button onclick="bukaModalPengaturan()" class="flex flex-col items-center text-slate-400 text-[10px] font-medium">
            <span class="text-base">⚙️</span>
            <span>Toko</span>
        </button>
    </div>

    <!-- 3. AREA KONTEN UTAMA -->
    <div class="flex-1 flex flex-col h-screen overflow-y-auto">
        
        <header class="bg-slate-800/90 backdrop-blur border-b border-slate-700 p-3 sticky top-0 z-10 flex justify-between items-center px-4 md:px-6">
            <div class="flex items-center gap-2">
                <h2 id="page-title" class="text-xs md:text-sm font-semibold text-slate-200">Mode Kasir (Offline)</h2>
            </div>
            <div class="text-xs text-slate-400 flex items-center gap-2">
                <span class="hidden sm:inline">Kasir:</span>
                <span id="display-nama-kasir" class="text-emerald-400 font-medium">Admin Toko</span>
                <button onclick="bukaModalPengaturan()" class="md:hidden text-xs bg-slate-700 p-1 rounded hover:bg-slate-600">⚙️</button>
            </div>
        </header>

        <main class="p-4 md:p-6 max-w-5xl mx-auto w-full">

            <!-- PAGE 1: KASIR UTAMA -->
            <div id="page-kasir" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <div class="lg:col-span-7 space-y-4">
                    <section class="bg-slate-800 rounded-xl p-4 border border-slate-700 shadow-lg space-y-3">
                        <div class="bg-slate-950/80 rounded-lg p-3 border-2 border-dashed border-emerald-500/40 text-center relative overflow-hidden">
                            <div id="reader" class="w-full max-w-xs mx-auto min-h-[140px] bg-slate-900 rounded flex items-center justify-center text-xs text-slate-500">
                                📷 Camera Scanner Matikan
                            </div>
                            <div class="mt-3 flex gap-2 justify-center">
                                <button onclick="mulaiScannerKasir()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs px-4 py-2 rounded-lg font-semibold shadow-md transition">
                                    ⚡ Buka Kamera Scan
                                </button>
                                <button onclick="stopScanner()" class="bg-slate-700 hover:bg-slate-600 text-slate-300 text-xs px-3 py-2 rounded-lg font-semibold border border-slate-600 transition">
                                    ⏹️ Stop
                                </button>
                            </div>
                        </div>

                        <div class="relative flex py-1 items-center">
                            <div class="flex-grow border-t border-slate-700"></div>
                            <span class="flex-shrink mx-3 text-[10px] text-slate-400 uppercase font-semibold">Input Manual / Kiloan</span>
                            <div class="flex-grow border-t border-slate-700"></div>
                        </div>

                        <form id="form-manual" onsubmit="tambahItemManual(event)" class="grid grid-cols-12 gap-2 text-xs">
                            <input id="input-nama" type="text" placeholder="Nama barang" required class="col-span-12 sm:col-span-5 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                            <input id="input-harga" type="number" placeholder="Harga/Unit" required class="col-span-8 sm:col-span-4 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                            <button type="submit" class="col-span-4 sm:col-span-3 bg-slate-700 hover:bg-slate-600 text-slate-200 font-semibold rounded-lg border border-slate-600">
                                + Tambah
                            </button>
                        </form>
                    </section>

                    <section class="bg-slate-800 rounded-xl p-4 border border-slate-700 shadow-lg">
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider">Daftar Transaksi</h3>
                            <button onclick="kosongkanKeranjang()" class="text-xs text-rose-400 hover:underline">Kosongkan</button>
                        </div>

                        <div id="keranjang-list" class="space-y-2 mb-4 max-h-56 overflow-y-auto pr-1"></div>

                        <div class="border-t border-slate-700 pt-3 space-y-2">
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-400">Total Belanja:</span>
                                <span id="total-harga" class="font-bold text-base text-emerald-400">Rp 0</span>
                            </div>
                            <button onclick="selesaikanTransaksi()" class="w-full bg-emerald-600 hover:bg-emerald-500 font-bold py-2.5 rounded-lg text-sm transition shadow-lg shadow-emerald-950">
                                Selesaikan Transaksi
                            </button>
                        </div>
                    </section>
                </div>

                <div class="lg:col-span-5 space-y-4">
                    <section class="bg-slate-800 rounded-xl p-4 border border-slate-700 shadow-lg space-y-3">
                        <div class="flex justify-between items-center">
                            <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider">Preview Struk</h3>
                            <span class="text-[10px] bg-slate-700 px-2 py-0.5 rounded text-slate-300">Siap Cetak</span>
                        </div>

                        <div id="struk-area" class="bg-white text-slate-900 p-4 rounded-md font-mono text-[11px] space-y-2 shadow-inner border border-slate-300">
                            <div class="text-center border-b border-dashed border-slate-400 pb-2">
                                <p id="struk-nama-toko" class="font-bold text-xs uppercase">TOKO SEMBAKO BAROKAH</p>
                                <p id="struk-alamat-toko" class="text-[9px] text-slate-600">Jl. Raya No. 12 Pasuruan</p>
                                <p id="struk-waktu" class="text-[9px] text-slate-500 mt-1">-</p>
                            </div>

                            <div id="struk-items" class="space-y-1"></div>

                            <div class="border-t border-dashed border-slate-400 pt-1 flex justify-between font-bold text-xs">
                                <span>TOTAL:</span>
                                <span id="struk-total">Rp 0</span>
                            </div>

                            <p class="text-center text-[9px] text-slate-500 pt-2 border-t border-slate-200">
                                -- Terima Kasih --
                            </p>
                        </div>

                        <div class="space-y-2 pt-1">
                            <button onclick="cetakStruk()" class="w-full bg-slate-700 hover:bg-slate-600 text-slate-100 text-xs py-2.5 rounded-lg font-semibold border border-slate-600 flex items-center justify-center gap-2 transition">
                                🖨️ Cetak Struk (Printer Thermal)
                            </button>

                            <div class="grid grid-cols-2 gap-2">
                                <button onclick="simpanGambar()" class="bg-slate-700/60 hover:bg-slate-600 text-slate-200 text-xs py-2 rounded-lg font-medium border border-slate-600 flex justify-center items-center gap-1">
                                    💾 Simpan Gambar
                                </button>
                                <button onclick="kirimWA()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs py-2 rounded-lg font-medium flex justify-center items-center gap-1 shadow-md">
                                    📲 Kirim WA
                                </button>
                            </div>
                        </div>
                    </section>
                </div>

            </div>

            <!-- PAGE 2: STOK BARANG -->
            <div id="page-stok" class="hidden space-y-4">
                <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
                    <h3 class="text-sm font-bold text-emerald-400 uppercase tracking-wider mb-4">📦 Update Stok Barang</h3>
                    <div id="stok-list" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
                </div>
            </div>

            <!-- PAGE 3: KEUANGAN & LAPORAN -->
            <div id="page-keuangan" class="hidden space-y-4">
                <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b border-slate-700 pb-4">
                        <div>
                            <h3 class="text-base font-bold text-emerald-400">💰 Laporan & Rekap Penjualan</h3>
                            <p class="text-xs text-slate-400">Filter hasil penjualan dan ekspor ke format Excel.</p>
                        </div>

                        <div class="flex flex-wrap items-center gap-2">
                            <div class="flex gap-1 bg-slate-900 p-1 rounded-lg border border-slate-700">
                                <button onclick="filterLaporan('semua')" id="filter-semua" class="px-3 py-1.5 text-xs font-semibold rounded-md bg-emerald-600 text-white shadow">Semua</button>
                                <button onclick="filterLaporan('hari')" id="filter-hari" class="px-3 py-1.5 text-xs font-semibold rounded-md text-slate-300 hover:bg-slate-700">Hari Ini</button>
                                <button onclick="filterLaporan('minggu')" id="filter-minggu" class="px-3 py-1.5 text-xs font-semibold rounded-md text-slate-300 hover:bg-slate-700">Minggu Ini</button>
                                <button onclick="filterLaporan('bulan')" id="filter-bulan" class="px-3 py-1.5 text-xs font-semibold rounded-md text-slate-300 hover:bg-slate-700">Bulan Ini</button>
                            </div>

                            <button onclick="eksporKeExcel()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-3 py-2 rounded-lg shadow-md flex items-center gap-1.5 transition">
                                📊 Ekspor Excel
                            </button>
                        </div>
                    </div>

                    <!-- FORM INPUT MANUAL KEUANGAN -->
                    <div class="bg-slate-900 p-4 rounded-xl border border-slate-700 mb-6">
                        <h4 class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-3">➕ Tambah Transaksi Manual</h4>
                        <form onsubmit="tambahTransaksiManualKeuangan(event)" class="grid grid-cols-12 gap-3 text-xs">
                            <input id="trx-manual-nama" type="text" placeholder="Keterangan / Item Belanja" required class="col-span-12 md:col-span-5 bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                            <input id="trx-manual-nominal" type="number" placeholder="Nominal Total (Rp)" required class="col-span-12 md:col-span-4 bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                            <button type="submit" class="col-span-12 md:col-span-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-lg py-2 transition shadow-md">
                                + Simpan Transaksi
                            </button>
                        </form>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        <div class="bg-slate-900 p-4 rounded-xl border border-slate-700">
                            <p class="text-xs text-slate-400">Total Pemasukan (<span id="periode-label">SEMUA</span>)</p>
                            <p id="total-pemasukan" class="text-2xl font-bold text-emerald-400 mt-1">Rp 0</p>
                        </div>
                        <div class="bg-slate-900 p-4 rounded-xl border border-slate-700">
                            <p class="text-xs text-slate-400">Total Transaksi Selesai</p>
                            <p id="total-transaksi-count" class="text-2xl font-bold text-amber-400 mt-1">0 Transaksi</p>
                        </div>
                    </div>

                    <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-3">📜 RIWAYAT TRANSAKSI TER-REKAP</h4>
                    <div class="overflow-x-auto rounded-lg border border-slate-700">
                        <table class="w-full text-left text-xs text-slate-300 border-collapse">
                            <thead>
                                <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                                    <th class="p-3">ID / No. Struk</th>
                                    <th class="p-3">Tanggal & Waktu</th>
                                    <th class="p-3">Item Belanja</th>
                                    <th class="p-3 text-right">Total Transaksi</th>
                                    <th class="p-3 text-center w-36">Aksi Edit / Hapus</th>
                                </tr>
                            </thead>
                            <tbody id="riwayat-transaksi-body" class="divide-y divide-slate-700/50"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- PAGE 4: DATABASE PRODUK -->
            <div id="page-database" class="hidden space-y-4">
                <div class="bg-slate-800 p-5 rounded-xl border border-slate-700 shadow-lg">
                    <h3 class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-3">➕ Tambah Barang ke Database</h3>
                    
                    <div class="mb-4 bg-slate-900 p-3 rounded-lg border border-slate-700/80">
                        <p class="text-[11px] text-slate-400 mb-2 font-medium">📷 Scan Kode Produk dengan Kamera:</p>
                        <div id="reader-db" class="w-full max-w-xs mx-auto min-h-[140px] bg-slate-950 rounded mb-2"></div>
                        <div class="flex gap-2 justify-center">
                            <button onclick="mulaiScannerDB()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-[11px] px-3 py-1.5 rounded font-semibold transition">
                                📷 Buka Kamera Scan Barcode
                            </button>
                            <button onclick="stopScannerDB()" class="bg-slate-700 text-slate-300 text-[11px] px-3 py-1.5 rounded transition">
                                ⏹️ Stop Scanner
                            </button>
                        </div>
                    </div>

                    <form onsubmit="tambahDatabaseBarang(event)" class="grid grid-cols-12 gap-3 text-xs">
                        <input id="db-barcode" type="text" placeholder="Kode Barcode / Unik (Auto)" class="col-span-12 md:col-span-4 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                        <input id="db-nama" type="text" placeholder="Nama Produk Sembako / UMKM" required class="col-span-12 md:col-span-4 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                        <input id="db-harga" type="number" placeholder="Harga (Rp)" required class="col-span-6 md:col-span-2 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                        <input id="db-stok" type="number" placeholder="Jumlah Stok" required class="col-span-6 md:col-span-2 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-emerald-500">

                        <div class="col-span-12 bg-slate-900/60 p-3 rounded-lg border border-slate-700 flex flex-col md:flex-row items-center justify-between gap-3">
                            <div>
                                <p class="text-xs font-semibold text-amber-400">🛍️ Untuk Produk UMKM (Tanpa Barcode)</p>
                                <p class="text-[10px] text-slate-400">Upload foto kemasan barang untuk pengenalan visual.</p>
                            </div>
                            <input id="db-foto" type="file" accept="image/*" class="text-xs text-slate-400 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:text-xs file:bg-slate-700 file:text-slate-200 hover:file:bg-slate-600">
                        </div>

                        <button type="submit" class="col-span-12 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 rounded-lg transition shadow-md">
                            + Simpan Barang ke Master Database
                        </button>
                    </form>
                </div>

                <div class="bg-slate-800 p-5 rounded-xl border border-slate-700 shadow-lg overflow-x-auto">
                    <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">🗄️ Master Database Barang</h3>
                    <table class="w-full text-left text-xs text-slate-300 border-collapse">
                        <thead>
                            <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                                <th class="p-2.5">Kemasan</th>
                                <th class="p-2.5">Barcode / Kode</th>
                                <th class="p-2.5">Nama Produk</th>
                                <th class="p-2.5">Harga</th>
                                <th class="p-2.5">Stok</th>
                                <th class="p-2.5 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="database-table-body" class="divide-y divide-slate-700/50"></tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <!-- MODAL EDIT KEUANGAN -->
    <div id="modal-edit-keuangan" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 max-w-sm w-full space-y-4 shadow-2xl">
            <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                <h3 class="text-sm font-bold text-emerald-400">✏️ Edit Nominal Transaksi</h3>
                <button onclick="tutupModalEditKeuangan()" class="text-slate-400 hover:text-slate-200">✕</button>
            </div>
            <form onsubmit="simpanEditKeuangan(event)" class="space-y-3 text-xs">
                <input id="edit-trx-id" type="hidden">
                <div>
                    <label class="block text-slate-400 mb-1">Total Nominal Transaksi (Rp):</label>
                    <input id="edit-trx-total" type="number" required class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                </div>
                <div class="pt-2 flex gap-2">
                    <button type="submit" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 rounded-lg transition">Simpan Perubahan</button>
                    <button type="button" onclick="tutupModalEditKeuangan()" class="bg-slate-700 text-slate-300 py-2 px-3 rounded-lg">Batal</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL PENGATURAN TOKO -->
    <div id="modal-pengaturan" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 max-w-sm w-full space-y-4 shadow-2xl">
            <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                <h3 class="text-sm font-bold text-emerald-400">⚙️ Pengaturan Toko & Kasir</h3>
                <button onclick="tutupModalPengaturan()" class="text-slate-400 hover:text-slate-200">✕</button>
            </div>
            <form onsubmit="simpanPengaturanToko(event)" class="space-y-3 text-xs">
                <div>
                    <label class="block text-slate-400 mb-1">Nama Toko / Usaha:</label>
                    <input id="cfg-nama-toko" type="text" required class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                </div>
                <div>
                    <label class="block text-slate-400 mb-1">Alamat / Kota Toko:</label>
                    <input id="cfg-alamat-toko" type="text" required class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                </div>
                <div>
                    <label class="block text-slate-400 mb-1">Nama Kasir yang Bertugas:</label>
                    <input id="cfg-nama-kasir" type="text" required class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-slate-200 focus:outline-none focus:border-emerald-500">
                </div>
                <div class="pt-2 flex gap-2">
                    <button type="submit" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 rounded-lg transition">Simpan Perubahan</button>
                    <button type="button" onclick="tutupModalPengaturan()" class="bg-slate-700 text-slate-300 py-2 px-3 rounded-lg">Batal</button>
                </div>
            </form>
        </div>
    </div>

    <!-- LOGIKA JAVASCRIPT -->
    <script>
        let html5QrCodeKasir = null;
        let html5QrCodeDB = null;

        let profilToko = {
            nama: "TOKO SEMBAKO BAROKAH",
            alamat: "Jl. Raya No. 12 Pasuruan",
            kasir: "Admin Toko"
        };

        let masterDatabase = [
            { id: "899100110201", nama: "Minyak Goreng 1L", harga: 16500, stok: 24, foto: null },
            { id: "089686010018", nama: "Indomie Goreng Original", harga: 3100, stok: 120, foto: null },
            { id: "UMKM-KERIPIK", nama: "Keripik Tempe UMKM Pasuruan", harga: 12000, stok: 15, foto: "https://via.placeholder.com/40" },
            { id: "MANUAL-01", nama: "Beras Premium (Kiloan)", harga: 14000, stok: 100, foto: null }
        ];

        let keranjang = [
            { id: "089686010018", nama: "Indomie Goreng Original", harga: 3100, qty: 3, info: "Barcode: 089686010018" }
        ];

        let riwayatTransaksi = [
            {
                id: "TRX-1001",
                waktu: new Date(),
                items: [{ nama: "Minyak Goreng 1L", qty: 2, harga: 16500 }],
                total: 33000
            }
        ];

        let filterAktif = 'semua';
        let dataFilteredSaatIni = [];

        function formatRupiah(angka) {
            return "Rp " + Number(angka).toLocaleString('id-ID');
        }

        function formatWaktuLengkap(d) {
            const pad = (n) => n < 10 ? '0' + n : n;
            const dateObj = new Date(d);
            return `${pad(dateObj.getDate())}/${pad(dateObj.getMonth()+1)}/${dateObj.getFullYear()} - ${pad(dateObj.getHours())}:${pad(dateObj.getMinutes())} WIB`;
        }

        function updateUI() {
            document.getElementById('display-nama-kasir').innerText = profilToko.kasir;
            document.getElementById('struk-nama-toko').innerText = profilToko.nama;
            document.getElementById('struk-alamat-toko').innerText = profilToko.alamat;

            const listEl = document.getElementById('keranjang-list');
            const strukItemsEl = document.getElementById('struk-items');
            let total = 0;

            listEl.innerHTML = "";
            strukItemsEl.innerHTML = "";

            if (keranjang.length === 0) {
                listEl.innerHTML = `<p class="text-xs text-slate-500 text-center py-4">Keranjang kosong</p>`;
                strukItemsEl.innerHTML = `<p class="text-[10px] text-slate-400 text-center py-2">- Tidak ada barang -</p>`;
            } else {
                keranjang.forEach((item, index) => {
                    const subtotal = item.harga * item.qty;
                    total += subtotal;

                    listEl.innerHTML += `
                        <div class="flex justify-between items-center bg-slate-900/60 p-2.5 rounded-lg border border-slate-700/50">
                            <div>
                                <p class="text-xs font-semibold text-slate-200">${item.nama}</p>
                                <p class="text-[10px] text-slate-400">${item.info}</p>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="text-right">
                                    <p class="text-xs font-bold text-emerald-400">${formatRupiah(subtotal)}</p>
                                    <p class="text-[10px] text-slate-400">x${item.qty}</p>
                                </div>
                                <button onclick="hapusItem(${index})" class="text-rose-400 hover:text-rose-300 text-xs px-1">✕</button>
                            </div>
                        </div>
                    `;

                    strukItemsEl.innerHTML += `
                        <div class="flex justify-between">
                            <span>${item.qty}x ${item.nama}</span>
                            <span>${subtotal.toLocaleString('id-ID')}</span>
                        </div>
                    `;
                });
            }

            document.getElementById('total-harga').innerText = formatRupiah(total);
            document.getElementById('struk-total').innerText = formatRupiah(total);
            document.getElementById('struk-waktu').innerText = formatWaktuLengkap(new Date());

            renderDatabaseTable();
            renderStokCards();
            renderLaporan();
        }

        function bukaModalPengaturan() {
            document.getElementById('cfg-nama-toko').value = profilToko.nama;
            document.getElementById('cfg-alamat-toko').value = profilToko.alamat;
            document.getElementById('cfg-nama-kasir').value = profilToko.kasir;
            document.getElementById('modal-pengaturan').classList.remove('hidden');
        }

        function tutupModalPengaturan() {
            document.getElementById('modal-pengaturan').classList.add('hidden');
        }

        function simpanPengaturanToko(e) {
            e.preventDefault();
            profilToko.nama = document.getElementById('cfg-nama-toko').value;
            profilToko.alamat = document.getElementById('cfg-alamat-toko').value;
            profilToko.kasir = document.getElementById('cfg-nama-kasir').value;
            tutupModalPengaturan();
            updateUI();
        }

        function switchTab(tab) {
            ['kasir', 'stok', 'keuangan', 'database'].forEach(t => {
                document.getElementById(`page-${t}`).classList.add('hidden');
                
                const navBtn = document.getElementById(`nav-${t}`);
                if (navBtn) {
                    navBtn.className = "nav-btn w-full text-left flex items-center gap-3 px-3 py-2.5 text-slate-300 hover:bg-slate-700/60 rounded-lg text-sm transition";
                }
                
                const mobBtn = document.getElementById(`mob-${t}`);
                if (mobBtn) {
                    mobBtn.className = "flex flex-col items-center text-slate-400 text-[10px] font-medium";
                }
            });

            document.getElementById(`page-${tab}`).classList.remove('hidden');
            
            const activeNav = document.getElementById(`nav-${tab}`);
            if (activeNav) {
                activeNav.className = "nav-btn w-full text-left flex items-center gap-3 px-3 py-2.5 bg-emerald-600 text-white font-medium rounded-lg text-sm shadow-md transition";
            }
            
            const activeMob = document.getElementById(`mob-${tab}`);
            if (activeMob) {
                activeMob.className = "flex flex-col items-center text-emerald-400 text-[10px] font-medium";
            }

            const titles = {
                kasir: "Mode Kasir (Offline)",
                stok: "Manajemen Stok Barang",
                keuangan: "Keuangan & Laporan Penjualan",
                database: "Database Master Produk"
            };
            document.getElementById('page-title').innerText = titles[tab];

            if (tab !== 'kasir') stopScanner();
            if (tab !== 'database') stopScannerDB();
        }

        function tambahItemManual(e) {
            e.preventDefault();
            const nama = document.getElementById('input-nama').value;
            const harga = parseFloat(document.getElementById('input-harga').value);
            
            keranjang.push({
                id: "MANUAL-" + Date.now(),
                nama: nama,
                harga: harga,
                qty: 1,
                info: "Input Manual"
            });

            document.getElementById('input-nama').value = "";
            document.getElementById('input-harga').value = "";
            updateUI();
        }

        function hapusItem(index) {
            keranjang.splice(index, 1);
            updateUI();
        }

        function kosongkanKeranjang() {
            keranjang = [];
            updateUI();
        }

        function selesaikanTransaksi() {
            if (keranjang.length === 0) {
                alert("Keranjang masih kosong!");
                return;
            }

            let total = 0;
            const items = keranjang.map(i => {
                total += i.harga * i.qty;
                return { nama: i.nama, qty: i.qty, harga: i.harga };
            });

            const trx = {
                id: "TRX-" + Math.floor(1000 + Math.random() * 9000),
                waktu: new Date(),
                items: items,
                total: total
            };

            riwayatTransaksi.unshift(trx);
            
            keranjang.forEach(item => {
                const dbItem = masterDatabase.find(d => d.id === item.id || d.nama === item.nama);
                if (dbItem) {
                    dbItem.stok = Math.max(0, dbItem.stok - item.qty);
                }
            });

            alert(`Transaksi berhasil diselesaikan! ID: ${trx.id}`);
            keranjang = [];
            updateUI();
        }

        function mulaiScannerKasir() {
            if (html5QrCodeKasir) stopScanner();
            html5QrCodeKasir = new Html5Qrcode("reader");
            html5QrCodeKasir.start(
                { facingMode: "environment" },
                { fps: 10, qrbox: { width: 200, height: 150 } },
                (decodedText) => {
                    const item = masterDatabase.find(d => d.id === decodedText);
                    if (item) {
                        const existing = keranjang.find(k => k.id === item.id);
                        if (existing) {
                            existing.qty++;
                        } else {
                            keranjang.push({
                                id: item.id,
                                nama: item.nama,
                                harga: item.harga,
                                qty: 1,
                                info: "Barcode: " + item.id
                            });
                        }
                        updateUI();
                    } else {
                        alert("Barang tidak ditemukan di database! Barcode: " + decodedText);
                    }
                },
                (error) => {}
            ).catch(err => console.log(err));
        }

        function stopScanner() {
            if (html5QrCodeKasir) {
                html5QrCodeKasir.stop().then(() => {
                    html5QrCodeKasir = null;
                    document.getElementById('reader').innerText = "📷 Camera Scanner Matikan";
                }).catch(err => console.log(err));
            }
        }

        function mulaiScannerDB() {
            if (html5QrCodeDB) stopScannerDB();
            html5QrCodeDB = new Html5Qrcode("reader-db");
            html5QrCodeDB.start(
                { facingMode: "environment" },
                { fps: 10, qrbox: { width: 200, height: 150 } },
                (decodedText) => {
                    document.getElementById('db-barcode').value = decodedText;
                    stopScannerDB();
                },
                (error) => {}
            ).catch(err => console.log(err));
        }

        function stopScannerDB() {
            if (html5QrCodeDB) {
                html5QrCodeDB.stop().then(() => {
                    html5QrCodeDB = null;
                    document.getElementById('reader-db').innerText = "";
                }).catch(err => console.log(err));
            }
        }

        function cetakStruk() {
            window.print();
        }

        function simpanGambar() {
            const area = document.getElementById('struk-area');
            html2canvas(area).then(canvas => {
                const link = document.createElement('a');
                link.download = `Struk-${Date.now()}.png`;
                link.href = canvas.toDataURL();
                link.click();
            });
        }

        function kirimWA() {
            if (keranjang.length === 0) {
                alert("Keranjang kosong!");
                return;
            }
            let teks = `*${profilToko.nama}*\n${profilToko.alamat}\n-----------------------------\n`;
            let total = 0;
            keranjang.forEach(i => {
                const sub = i.harga * i.qty;
                total += sub;
                teks += `${i.qty}x ${i.nama} = Rp ${sub.toLocaleString('id-ID')}\n`;
            });
            teks += `-----------------------------\n*Total: Rp ${total.toLocaleString('id-ID')}*\nKasir: ${profilToko.kasir}\nTerima kasih!`;
            
            const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(teks)}`;
            window.open(url, '_blank');
        }

        function renderStokCards() {
            const container = document.getElementById('stok-list');
            container.innerHTML = "";

            masterDatabase.forEach((item, index) => {
                container.innerHTML += `
                    <div class="bg-slate-900 p-3 rounded-lg border border-slate-700 flex justify-between items-center text-xs">
                        <div>
                            <p class="font-bold text-slate-200">${item.nama}</p>
                            <p class="text-slate-400 text-[10px]">${formatRupiah(item.harga)} | Code: ${item.id}</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="ubahStok(${index}, -1)" class="bg-slate-700 hover:bg-slate-600 px-2 py-1 rounded text-slate-200 font-bold">-</button>
                            <span class="font-bold text-emerald-400 min-w-[24px] text-center">${item.stok}</span>
                            <button onclick="ubahStok(${index}, 1)" class="bg-slate-700 hover:bg-slate-600 px-2 py-1 rounded text-slate-200 font-bold">+</button>
                        </div>
                    </div>
                `;
            });
        }

        function ubahStok(index, delta) {
            masterDatabase[index].stok = Math.max(0, masterDatabase[index].stok + delta);
            updateUI();
        }

        function renderDatabaseTable() {
            const tbody = document.getElementById('database-table-body');
            tbody.innerHTML = "";

            masterDatabase.forEach((item, index) => {
                const imgHtml = item.foto 
                    ? `<img src="${item.foto}" class="w-8 h-8 object-cover rounded">` 
                    : `<div class="w-8 h-8 bg-slate-700 rounded flex items-center justify-center text-[10px]">📦</div>`;

                tbody.innerHTML += `
                    <tr>
                        <td class="p-2.5">${imgHtml}</td>
                        <td class="p-2.5 font-mono text-[11px] text-slate-400">${item.id}</td>
                        <td class="p-2.5 font-semibold text-slate-200">${item.nama}</td>
                        <td class="p-2.5 text-emerald-400 font-medium">${formatRupiah(item.harga)}</td>
                        <td class="p-2.5 font-bold">${item.stok}</td>
                        <td class="p-2.5 text-center">
                            <button onclick="hapusDatabaseItem(${index})" class="text-rose-400 hover:text-rose-300 font-medium">Hapus</button>
                        </td>
                    </tr>
                `;
            });
        }

        function tambahDatabaseBarang(e) {
            e.preventDefault();
            const barcode = document.getElementById('db-barcode').value || ("ITEM-" + Date.now());
            const nama = document.getElementById('db-nama').value;
            const harga = parseFloat(document.getElementById('db-harga').value);
            const stok = parseInt(document.getElementById('db-stok').value);
            const fileInput = document.getElementById('db-foto');

            const prosesSimpan = (fotoUrl) => {
                masterDatabase.push({
                    id: barcode,
                    nama: nama,
                    harga: harga,
                    stok: stok,
                    foto: fotoUrl
                });

                document.getElementById('db-barcode').value = "";
                document.getElementById('db-nama').value = "";
                document.getElementById('db-harga').value = "";
                document.getElementById('db-stok').value = "";
                fileInput.value = "";

                updateUI();
            };

            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    prosesSimpan(e.target.result);
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else {
                prosesSimpan(null);
            }
        }

        function hapusDatabaseItem(index) {
            if (confirm("Yakin ingin menghapus barang ini dari database?")) {
                masterDatabase.splice(index, 1);
                updateUI();
            }
        }

        function filterLaporan(jenis) {
            filterAktif = jenis;
            ['semua', 'hari', 'minggu', 'bulan'].forEach(f => {
                const btn = document.getElementById(`filter-${f}`);
                if (btn) {
                    if (f === jenis) {
                        btn.className = "px-3 py-1.5 text-xs font-semibold rounded-md bg-emerald-600 text-white shadow";
                    } else {
                        btn.className = "px-3 py-1.5 text-xs font-semibold rounded-md text-slate-300 hover:bg-slate-700";
                    }
                }
            });
            renderLaporan();
        }

        function renderLaporan() {
            const now = new Date();
            dataFilteredSaatIni = riwayatTransaksi.filter(trx => {
                const tDate = new Date(trx.waktu);
                if (filterAktif === 'hari') {
                    return tDate.toDateString() === now.toDateString();
                } else if (filterAktif === 'minggu') {
                    const selisihHari = (now - tDate) / (1000 * 60 * 60 * 24);
                    return selisihHari <= 7;
                } else if (filterAktif === 'bulan') {
                    return tDate.getMonth() === now.getMonth() && tDate.getFullYear() === now.getFullYear();
                }
                return true;
            });

            const tbody = document.getElementById('riwayat-transaksi-body');
            let totalPemasukan = 0;
            tbody.innerHTML = "";

            if (dataFilteredSaatIni.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-500">Tidak ada riwayat transaksi pada periode ini.</td></tr>`;
            } else {
                dataFilteredSaatIni.forEach((trx) => {
                    totalPemasukan += trx.total;
                    const itemsStr = trx.items.map(i => `${i.qty}x ${i.nama}`).join(', ');

                    tbody.innerHTML += `
                        <tr>
                            <td class="p-3 font-mono text-[11px] text-slate-400">${trx.id}</td>
                            <td class="p-3 text-[11px]">${formatWaktuLengkap(trx.waktu)}</td>
                            <td class="p-3 font-medium text-slate-200">${itemsStr}</td>
                            <td class="p-3 text-right font-bold text-emerald-400">${formatRupiah(trx.total)}</td>
                            <td class="p-3 text-center space-x-2">
                                <button onclick="bukaModalEditKeuangan('${trx.id}')" class="text-amber-400 hover:underline">Edit</button>
                                <button onclick="hapusTransaksiKeuangan('${trx.id}')" class="text-rose-400 hover:underline">Hapus</button>
                            </td>
                        </tr>
                    `;
                });
            }

            document.getElementById('total-pemasukan').innerText = formatRupiah(totalPemasukan);
            document.getElementById('total-transaksi-count').innerText = `${dataFilteredSaatIni.length} Transaksi`;
            document.getElementById('periode-label').innerText = filterAktif.toUpperCase();
        }

        function tambahTransaksiManualKeuangan(e) {
            e.preventDefault();
            const nama = document.getElementById('trx-manual-nama').value;
            const nominal = parseFloat(document.getElementById('trx-manual-nominal').value);

            riwayatTransaksi.unshift({
                id: "TRX-M-" + Math.floor(1000 + Math.random() * 9000),
                waktu: new Date(),
                items: [{ nama: nama, qty: 1, harga: nominal }],
                total: nominal
            });

            document.getElementById('trx-manual-nama').value = "";
            document.getElementById('trx-manual-nominal').value = "";
            updateUI();
        }

        function bukaModalEditKeuangan(id) {
            const trx = riwayatTransaksi.find(t => t.id === id);
            if (trx) {
                document.getElementById('edit-trx-id').value = trx.id;
                document.getElementById('edit-trx-total').value = trx.total;
                document.getElementById('modal-edit-keuangan').classList.remove('hidden');
            }
        }

        function tutupModalEditKeuangan() {
            document.getElementById('modal-edit-keuangan').classList.add('hidden');
        }

        function simpanEditKeuangan(e) {
            e.preventDefault();
            const id = document.getElementById('edit-trx-id').value;
            const totalBaru = parseFloat(document.getElementById('edit-trx-total').value);

            const trx = riwayatTransaksi.find(t => t.id === id);
            if (trx) {
                trx.total = totalBaru;
                if (trx.items.length === 1) {
                    trx.items[0].harga = totalBaru;
                }
            }

            tutupModalEditKeuangan();
            updateUI();
        }

        function hapusTransaksiKeuangan(id) {
            if (confirm("Hapus catatan transaksi ini dari riwayat?")) {
                riwayatTransaksi = riwayatTransaksi.filter(t => t.id !== id);
                updateUI();
            }
        }

        function eksporKeExcel() {
            if (dataFilteredSaatIni.length === 0) {
                alert("Tidak ada data untuk diekspor!");
                return;
            }

            const dataExcel = dataFilteredSaatIni.map(t => ({
                "ID Transaksi": t.id,
                "Tanggal & Waktu": formatWaktuLengkap(t.waktu),
                "Item Belanja": t.items.map(i => `${i.qty}x ${i.nama}`).join(', '),
                "Total (Rp)": t.total
            }));

            const worksheet = XLSX.utils.json_to_sheet(dataExcel);
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, "Laporan Penjualan");

            XLSX.writeFile(workbook, `Laporan_Penjualan_${filterAktif}_${Date.now()}.xlsx`);
        }

        // Inisialisasi awal UI saat halaman dimuat
        window.onload = function() {
            updateUI();
        };
    </script>
</body>
</html>
